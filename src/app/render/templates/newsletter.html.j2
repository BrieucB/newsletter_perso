<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ issue.subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f5f4ef;color:#1f2933;font-family:Georgia,'Times New Roman',serif;">
    <div style="max-width:700px;margin:0 auto;padding:32px 20px;">
      <div style="background:#fffdf8;border:1px solid #ded6c9;border-radius:12px;padding:28px;">
        <p style="margin:0 0 10px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#8b6f47;">
          Personal Newsletter
        </p>
        <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;color:#102a43;">{{ issue.subject }}</h1>
        <p style="margin:0 0 24px;font-size:16px;line-height:1.6;">{{ issue.intro }}</p>

        {% if issue.selection_notes %}
          <div style="margin:0 0 24px;padding:14px 16px;background:#f8f3ea;border:1px solid #eadfce;border-radius:10px;">
            <p style="margin:0 0 8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#8b6f47;">
              Selection Notes
            </p>
            {% for note in issue.selection_notes %}
              <p style="margin:0 0 6px;font-size:14px;line-height:1.5;color:#334e68;">{{ note }}</p>
            {% endfor %}
          </div>
        {% endif %}

        {% for section in issue.sections %}
          {% if section.items %}
            <h2 style="margin:28px 0 12px;font-size:20px;color:#7c2d12;border-top:1px solid #eadfce;padding-top:18px;">
              {{ section.name }}
            </h2>
            {% for item in section.items %}
              <div style="margin:0 0 20px;padding:0 0 18px;border-bottom:1px solid #f0e6d9;">
                <h3 style="margin:0 0 8px;font-size:18px;line-height:1.3;color:#102a43;">{{ item.title }}</h3>
                <p style="margin:0 0 8px;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#7b8794;">
                  {{ item.fit_tag.replace('_', ' ') }}
                </p>
                <p style="margin:0 0 10px;font-size:15px;line-height:1.65;">{{ item.what_happened }}</p>
                <p style="margin:0 0 10px;font-size:15px;line-height:1.65;">
                  <strong>Why you should care:</strong> {{ item.why_you_should_care }}
                </p>
                <p style="margin:0;font-size:14px;line-height:1.5;color:#486581;">
                  <strong>{{ item.source_name }}</strong> ·
                  <a href="{{ item.source_url }}" style="color:#0f5f8c;">Source link</a>
                </p>
                {% set item_feedback = feedback_links.get(item.candidate_id) %}
                {% if item_feedback %}
                  <p style="margin:10px 0 0;font-size:13px;line-height:1.5;color:#486581;">
                    <a href="{{ item_feedback.upvote_url }}" style="color:#0f5f8c;">+ good rec</a>
                    ·
                    <a href="{{ item_feedback.downvote_url }}" style="color:#0f5f8c;">- bad rec</a>
                  </p>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        {% endfor %}

        <p style="margin:20px 0 0;font-size:12px;color:#829ab1;">
          Generated at {{ generated_at.isoformat() }}
        </p>
      </div>
    </div>
  </body>
</html>
